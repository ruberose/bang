<?xml version="1.0" encoding="utf-8"?>
<!--
  앱 매니페스트: 앱 이름, 테마, 시작 화면(Activity) 등을 안드로이드 시스템에 알려주는 파일.
  아이콘은 8단계에서 추가한다. (지금은 시스템 기본 아이콘이 표시됨)
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bang">

        <!--
          screenOrientation="portrait": SPEC 7장 "세로 모드 고정".
          화면 회전으로 Activity가 다시 만들어지면 게임 진행이 끊길 수 있으므로 막는다.
          exported="true": 런처(홈 화면)에서 실행할 수 있어야 하므로 필요.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
